# =============================================================================
#  Sao chép thành .env.local rồi điền. KHÔNG commit .env.local.
#
#  App CHỈ chạy với Supabase — không có chế độ giả lập. Thiếu biến thì báo lỗi.
#
#  Supabase chạy local bằng Docker:
#     npm run db:start     -> khởi động stack, tự chạy migration + seed
#     npm run db:status    -> in ra URL và các key dưới đây
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Local:      http://127.0.0.1:54321
# Trên cloud: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  BÍ MẬT. Chỉ chạy phía server, KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_.
# Biến NEXT_PUBLIC_* bị nhúng vào bundle gửi xuống trình duyệt; lộ key này là
# lộ toàn quyền database, bỏ qua mọi RLS.
# Chỉ dùng cho: tạo tài khoản người thuê, đặt lại mật khẩu, xoá tài khoản.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Dùng để dựng link trong email đặt lại mật khẩu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bảo vệ /api/cron/keep-alive. Không đặt thì endpoint đó trả 503.
CRON_SECRET=
