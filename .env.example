# =============================================================================
#  Sao chép thành .env.local rồi điền. KHÔNG commit .env.local.
#
#  App CHỈ chạy với Supabase — không có chế độ giả lập. Thiếu biến thì báo lỗi.
#
#  Hai cách chạy:
#
#    A. Trỏ sang project Supabase CLOUD  ← xem mục 3 trong README
#       Điền khối "Supabase" bên dưới bằng giá trị lấy từ dashboard.
#
#    B. Chạy Supabase LOCAL bằng Docker
#       npm run db:start     -> khởi động stack, tự chạy migration + seed
#       npm run db:status    -> in ra URL và các key dưới đây
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Cloud:  Project Settings > API > Project URL      -> https://<ref>.supabase.co
# Local:  http://127.0.0.1:54321
#
# ⚠️  next.config.ts ĐỌC BIẾN NÀY LÚC BUILD để cho `next/image` phép tải ảnh từ
# host Supabase (images.remotePatterns). Đổi biến này thì phải BUILD LẠI —
# `next dev` khởi động lại là đủ, còn trên Vercel thì phải deploy lại. Không
# build lại thì ảnh phòng trả 400 và không hiện.
NEXT_PUBLIC_SUPABASE_URL=

# Cloud:  Project Settings > API Keys > `anon` (dashboard mới gọi là
#         "Publishable key", giá trị bắt đầu bằng `sb_publishable_...`)
# Local:  npm run db:status
#
# Không bí mật — key này CHỈ đọc/ghi được những gì RLS cho phép.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloud:  Project Settings > API Keys > `service_role` (dashboard mới gọi là
#         "Secret key", giá trị bắt đầu bằng `sb_secret_...`)
#
# ⚠️  BÍ MẬT. Chỉ chạy phía server, KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_.
# Biến NEXT_PUBLIC_* bị nhúng vào bundle gửi xuống trình duyệt; lộ key này là
# lộ toàn quyền database, bỏ qua mọi RLS.
# Chỉ dùng cho: tạo tài khoản người thuê, đặt lại mật khẩu, xoá tài khoản, và
# dọn ảnh CCCD của tài khoản vừa bị xoá (xem deleteTenant trong supabase-adapter).
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (chỉ dùng để migrate, app KHÔNG đọc) ------------------------
# Hai biến này dành cho `npx supabase link` / `db push` / `config push`.
#
# ⚠️  CLI KHÔNG đọc `.env.local`. Nó chỉ đọc biến môi trường của shell, và đọc
# file `.env` (không phải `.env.local`) cho cú pháp `env(...)` trong
# supabase/config.toml. Nên với hai biến này hãy export ra shell:
#
#     export SUPABASE_ACCESS_TOKEN=sbp_...
#     export SUPABASE_DB_PASSWORD='...'
#
# hoặc truyền thẳng: `npx supabase link --project-ref <ref> -p '<mật khẩu>'`
#
# SUPABASE_ACCESS_TOKEN: https://supabase.com/dashboard/account/tokens
#   Thiếu thì CLI hỏi đăng nhập bằng trình duyệt — vẫn chạy được.
#
# SUPABASE_DB_PASSWORD: mật khẩu Postgres đặt lúc tạo project.
#   Quên rồi thì đặt lại tại Project Settings > Database > Reset database password.
#   Đây KHÔNG phải mật khẩu đăng nhập supabase.com.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- App ----------------------------------------------------------------------
# Dùng để dựng link trong email đặt lại mật khẩu, và làm redirect URI cho Zalo.
#
# Chạy local mà trỏ vào DB cloud thì VẪN để http://localhost:3000.
# Deploy thật thì đổi thành domain thật, và nhớ khai đúng URL đó ở
# Authentication > URL Configuration trong dashboard (hoặc chạy
# `npx supabase config push` sau khi sửa supabase/config.toml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bảo vệ /api/cron/keep-alive và /api/cron/invoice-reminders.
# Không đặt thì hai endpoint đó trả 503.
# Sinh một chuỗi ngẫu nhiên: `openssl rand -hex 32`
CRON_SECRET=

# --- Email thông báo (tuỳ chọn) -----------------------------------------------
# Thiếu hai biến này thì app vẫn chạy đủ: thông báo hoá đơn vẫn hiện trong app,
# chỉ là không có bản gửi vào hộp thư người thuê.
#
# Lấy API key tại https://resend.com (free tier 3.000 email/tháng — nhà trọ 11
# phòng dùng khoảng 30 email/tháng).
#
# EMAIL_FROM phải thuộc domain ĐÃ XÁC THỰC trong Resend. Chưa có domain riêng thì
# dùng onboarding@resend.dev để thử, nhưng nó chỉ gửi được về đúng email đã đăng
# ký tài khoản Resend.
RESEND_API_KEY=
EMAIL_FROM="Nhà trọ Tân Phát <no-reply@nhatrotanphat.com>"

# --- Khoá cổng thông minh TTLock (tuỳ chọn) -----------------------------------
# Thiếu bốn biến này thì app vẫn chạy đủ: trang /admin/gate hiện danh sách việc
# cần làm để cài đặt, mã cổng quay về ghi chép thủ công ở hồ sơ người thuê. Không
# có lỗi đỏ ở đâu cả.
#
# Cần trước khi điền:
#   1. Tài khoản nhà phát triển tại https://euopen.ttlock.com — TTLock duyệt tay,
#      1–2 ngày. Duyệt xong tạo application (loại Web), chờ thêm vài ngày nữa mới
#      có clientId/clientSecret.
#   2. Một Gateway G2 (~950k, mua đứt) đã cắm điện, nối wifi 2.4GHz và đã ghép
#      với khoá trong app TTLock.
#
#      KHÔNG có gateway thì VẪN cấp được mã: /v3/keyboardPwd/get sinh mã bằng
#      thuật toán offline, ổ khoá tự xác thực. Nhưng thu hồi sớm, gia hạn, đọc
#      nhật ký ra vào, đồng bộ vân tay và xem pin thì đều cần gateway.
#
# TTLOCK_USERNAME / TTLOCK_PASSWORD là tài khoản CHỦ TRỌ trong app TTLock (tài
# khoản sở hữu khoá), KHÔNG phải tài khoản nhà phát triển. App tự băm MD5 mật
# khẩu trước khi gửi — điền mật khẩu thường ở đây.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=

# Máy chủ theo vùng. Xác nhận lại trong bảng điều khiển developer sau khi được duyệt.
# CHƯA ĐƯỢC ĐỌC Ở ĐÂU trong code — phần gọi HTTP sang TTLock chưa viết. Để sẵn
# cho lúc viết, không phải biến đang có tác dụng.
TTLOCK_API_BASE=https://euapi.ttlock.com

# --- Đăng nhập mạng xã hội (tuỳ chọn) -----------------------------------------
# Ba bước, thiếu bước nào cũng không chạy:
#   1. Điền id/secret ở dưới
#   2. Đặt enabled = true trong supabase/config.toml (Google/Facebook)
#   3. Bật cờ tương ứng trong src/config/site.ts -> houseConfig.login
#
# Trên CLOUD, bước 2 phải đẩy lên bằng `npx supabase config push`, hoặc bật tay
# tại Authentication > Sign In / Providers.
#
# ⚠️  Cú pháp `env(...)` trong config.toml đọc từ file `.env`, KHÔNG đọc
# `.env.local`. Muốn `config push` mang được secret lên thì export ra shell
# hoặc tạo thêm file `.env`.
#
# Redirect URI khai bên console của Google/Facebook:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   cloud: https://<project-ref>.supabase.co/auth/v1/callback

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Zalo KHÔNG đi qua Supabase — app tự xử lý luồng OAuth.
# Redirect URI khai ở Zalo Developers: <NEXT_PUBLIC_SITE_URL>/auth/zalo/callback
#   local: http://localhost:3000/auth/zalo/callback
ZALO_APP_ID=
ZALO_APP_SECRET=
